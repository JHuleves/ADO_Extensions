{
    "manifestVersion": 1,
    "id": "IncurrHoursButton",
    "version": "2.6.0",
    "name": "Time Sheet Entry",
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.identity",
        "vso.graph",
        "vso.project",
        "vso.security_manage"
    ],
    "description": "Concatenates fields into a multi-line field",
    "publisher": "JHuelves",
    "icons": {
        "default": "img/logo.png"
    },
    "targets": [{
        "id": "Microsoft.VisualStudio.Services"
    }],
    "categories": [
        "Azure Boards"
    ],
    "content": {
        "details": {
            "path": "README.md"
        },
        "license": {
            "path": "LICENSE.md"
        },
        "privacy": {
            "path": "PRIVACY.md"
        }
    },
    "files": [{
            "path": "img",
            "addressable": true
        },
        {
            "path": "scripts",
            "addressable": true
        },
        {
            "path": "styles",
            "addressable": true
        },
        {
            "path": "index.html",
            "addressable": true
        },
        {
            "path": "README.md",
            "addressable": true
        }
    ],
    "contributions": [{
        "id": "TimeSheetEntryControl",
        "description": "Time Sheet Entry button",
        "type": "ms.vss-work-web.work-item-form-control",
        "targets": [
            "ms.vss-work-web.work-item-form"
        ],
        "properties": {
            "name": "Time Sheet Entry Control",
            "uri": "index.html",
            "height": 50,
            "inputs": [
                {
                    "id": "FieldsToConcat",
                    "name": "Fields to Concatenate",
                    "type": "String",
                    "description": "Semicolon separated list of field reference names to concatenate.",
                    "properties": {
                        "defaultValue": ""
                    },
                    "validation": {
                        "isRequired": true
                    }
                },
                {
                    "id": "TargetField",
                    "name": "Target Field",
                    "type": "String",
                    "description": "Reference name of the multi-line field to store the result.",
                    "properties": {
                        "defaultValue": ""
                    },
                    "validation": {
                        "isRequired": true
                    }
                },
                {
                    "id": "ButtonText",
                    "name": "Button Text",
                    "type": "String",
                    "description": "Text to display on the button.",
                    "properties": {
                        "defaultValue": "Time Sheet Entry"
                    },
                    "validation": {
                        "isRequired": true
                    }
                },
                {
                    "id": "Log",
                    "name": "Log",
                    "type": "Boolean",
                    "description": "Enable console logging for debugging.",
                    "properties": {
                        "defaultValue": "false"
                    }
                }
            ]
        }
    }]
}
