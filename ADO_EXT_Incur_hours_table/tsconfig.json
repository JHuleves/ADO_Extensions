{
  "compilerOptions": {
    "module": "amd",
    "target": "es2017",
    "moduleResolution": "node",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "*": [
        "./node_modules/vss-web-extension-sdk/typings/*",
        "*"
      ]
    },
    "lib": [
      "es2017",
      "dom"
    ],
    "types": [
      "jquery",
      "vss-web-extension-sdk"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
