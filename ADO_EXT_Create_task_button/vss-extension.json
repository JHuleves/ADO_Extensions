            "addressable": true
        },
        {
            "path": "LICENSE.md",
            "addressable": true
        },
        {
            "path": "PRIVACY.md",
            "addressable": true
        },
        {
            "path": "README.md",
            "addressable": true
        },
        {
            "path": "test-main.js",
            "addressable": true
        },
        {
            "path": "widgetConfiguration.html",
            "addressable": true
        },
        {
            "path": "widgetCreateTaskButton.html",
